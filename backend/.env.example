# StockLens Backend Environment Variables Template
PROJECT_NAME="StockLens API"
VERSION="1.0.0"

# PostgreSQL Database connection:
# Replace username, password, host, port, and database name with your PostgreSQL credentials
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/stocklens"

# Allowed CORS origins for the frontend (comma-separated or JSON list)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"

# Path to Tesseract OCR executable (if not automatically on system PATH)
# On Windows, commonly: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD="tesseract"

# Image Upload Limit (bytes) - default 10MB (10485760)
MAX_UPLOAD_SIZE_BYTES=10485760
