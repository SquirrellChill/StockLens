# ---------------- Database (Postgres) ----------------
# Local Postgres (docker compose up -d):
DATABASE_URL=postgresql://stocklens:stocklens@localhost:5433/stocklens

# ---------------- Invoice reading ----------------
# AI reading (recommended: handles Khmer, English and mixed invoices, messy photos). Get a key at console.anthropic.com
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# auto = AI when a key is set, otherwise Tesseract | claude = AI only | tesseract = Tesseract only
# OCR_ENGINE=auto
# Languages for the Tesseract fallback (install the matching tesseract language packs)
# TESSERACT_LANGS=khm+eng

# ---------------- Core ----------------
# SECRET_KEY signs login tokens. If unset, one is generated once and stored in data/.secret_key
# SECRET_KEY=
# TOKEN_TTL_DAYS=7
# DB_POOL_SIZE=10

# ---------------- CORS (the frontend origin) ----------------
# Comma-separated list. localhost / LAN addresses on any port are always allowed in development.
# CORS_ORIGINS=https://app.example.com

# ---------------- Password-reset codes ----------------
# true  = return the 6-digit code in the API response (DEVELOPMENT ONLY, the frontend then shows it on screen)
# false = the code is only emailed (SMTP_*) or printed to the server console
DEV_EXPOSE_RESET_CODE=true

# ---------------- Email (optional). Without SMTP_HOST, reset codes are printed to the console. ----------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=StockLens <no-reply@example.com>
