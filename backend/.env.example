# StockLens Backend Environment Variables Example
PROJECT_NAME="StockLens API"

# Database connection:
# For PostgreSQL:
# DATABASE_URL="postgresql://postgres:your_password@localhost:5432/stocklens"
# For SQLite (local lightweight development / automated tests):
# DATABASE_URL="sqlite:///./stocklens.db"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stocklens"

# CORS origins (comma-separated or JSON list)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Path to Tesseract executable (if not in system PATH)
TESSERACT_CMD="tesseract"
